# Copy to deploy/.env and fill in. Never commit deploy/.env: it holds secrets.

# Your web address without https://, e.g. openwars.duckdns.org.
# The accounts service will be at api.<DOMAIN>.
DOMAIN=openwars.duckdns.org

# A long random secret shared by the game and the accounts service.
# Make one with:  openssl rand -hex 32
API_KEY=

# Discord sign-in (https://discord.com/developers/applications).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google sign-in (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Game servers to run (one per CPU core is plenty).
NUM_WORKERS=2

# Optional: Cloudflare Turnstile (bot protection on joins). Leave both empty
# to skip it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
